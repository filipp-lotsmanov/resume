# ---- LaTeX build artefacts ----
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb

# ---- uv / Python (the verifier uses PEP 723, so no project files belong here) ----
# Delete these two lines only if you deliberately made this a uv project.
pyproject.toml
.python-version
uv.lock
.venv/
__pycache__/

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- working images (previews, crops) ----
*.png

# ---- compiled PDF ----
# Listed here so local builds never show up in `git status`. The PDF is still
# committed to main: the build workflow force-adds it after a successful
# verify, so the repo always serves the current version at a stable URL.
# Removing this line would mean hand-committing local builds that CI has not
# checked.
resume.pdf
